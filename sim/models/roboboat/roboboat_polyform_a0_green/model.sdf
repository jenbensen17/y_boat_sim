<?xml version="1.0"?>
<sdf version="1.9">
  <model name="roboboat_polyform_a0_green">
    <link name="link">
      <inertial>
        <mass>0.635</mass>
        <inertia>
          <ixx>0.0026221</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0026221</iyy>
          <iyz>0</iyz>
          <izz>0.0026221</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere><radius>0.1016</radius></sphere>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere><radius>0.1016</radius></sphere>
        </geometry>
        <material>
          <ambient>0 0.4964 0.0562 1</ambient>
          <diffuse>0 0.4964 0.0562 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
