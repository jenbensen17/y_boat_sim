<?xml version="1.0"?>
<sdf version="1.9">
  <model name="roboboat_racquetball_blue">
    <link name="link">
      <inertial>
        <mass>0.04</mass>
        <inertia>
          <ixx>2.01667e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.01667e-05</iyy>
          <iyz>0</iyz>
          <izz>2.01667e-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere><radius>0.0275</radius></sphere>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere><radius>0.0275</radius></sphere>
        </geometry>
        <material>
          <ambient>0.3176 0.6118 0.8353 1</ambient>
          <diffuse>0.3176 0.6118 0.8353 1</diffuse>
          <specular>0.3176 0.6118 0.8353 1</specular>
        </material>
      </visual>
    </link>
    <plugin name="vrx::PolyhedraBuoyancyDrag" filename="libPolyhedraBuoyancyDrag.so">
      <linear_drag>0.5</linear_drag>
      <angular_drag>0.01</angular_drag>
      <buoyancy name="sphere">
        <link_name>link</link_name>
        <geometry>
          <sphere><radius>0.0275</radius></sphere>
        </geometry>
      </buoyancy>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>72</label>
    </plugin>
  </model>
</sdf>
