<?xml version="1.0"?>
<model>
  <name>BlueBoat (lite)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Rhys Mainwaring</name>
    <email>rhys.mainwaring@me.com</email>
  </author>
  <description>
    ArduPilot SITL_Models' BlueBoat with simplified visual meshes (~12.7k triangles
    instead of ~277k) so Gazebo renders smoothly without a GPU. Physics and plugins are
    identical to the original. 3D models originally from Blue Robotics:
    https://cad.bluerobotics.com/BLUEBOAT_120_BR-101447_RevA_PUB.zip
  </description>
</model>
