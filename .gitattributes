# Enforce Unix line endings (LF) across all operating systems, including Windows/WSL
* text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.sdf text eol=lf
*.parm text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf

# Binary assets: never convert line endings (it corrupts meshes and images).
*.stl binary
*.dae binary
*.glb binary
*.png binary
*.jpg binary
*.dds binary
